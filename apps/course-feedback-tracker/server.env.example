# 仅用于 CloudBase 云函数 feedback-api。录入函数环境变量/密钥，不要写入前端 VITE_* 或 Git。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 至少 32 个字符的随机串，用于派生学生扫码短链接的 token
PUBLIC_TOKEN_PEPPER=

FEISHU_SCHEDULE_APP_TOKEN=Xb34bXSVRaQk7ysfAQScPZp5nPh
FEISHU_SCHEDULE_TABLE_ID=tblWoTVtU4lqJoes
FEISHU_STUDENT_TABLE_ID=tblQGkH5DweXpOW8
FEISHU_FEEDBACK_APP_TOKEN=Lxy8bx4NQaw8XRsYszycSZHDnEb
FEISHU_RESPONSE_TABLE_ID=tblk7U1Y4shjRhZB
FEISHU_FORM_URL=https://ccntnl19k0y3.feishu.cn/share/base/form/shrcncMIqMOGeIZbmhNIwnThbSc

# 飞书开放平台「事件与回调」里的 Encrypt Key 和 Verification Token。
# 配了 Encrypt Key 就会强制验签；留空则只依赖 Verification Token。
FEISHU_EVENT_ENCRYPT_KEY=
FEISHU_EVENT_VERIFICATION_TOKEN=

# ---- 教务网站飞书登录（反馈工作台 / 取消课程 / 雅思正向率共用）----
# HTTP 访问服务里给 feedback-api 加的 /auth 路径；飞书开放平台「安全设置 → 重定向 URL」要加上 <这个地址>/feishu/callback
FEISHU_LOGIN_BASE_URL=https://app.jsjy.asia/auth
# 登录后允许跳回的网站（逗号分隔）。本地调试时加上 http://localhost:4176,http://localhost:4178
LOGIN_ALLOWED_ORIGINS=https://app.jsjy.asia
# CloudBase 控制台「身份认证 → 登录方式 → 自定义登录」下载的私钥文件路径（相对本目录，不要提交）
CLOUDBASE_LOGIN_KEY_FILE=

# ---- 官网老师数据接口 GET /site/teachers/stats ----
# 至少 32 个字符（openssl rand -hex 32）；官网服务器的 TEACHER_STATS_KEY 填同一个值。不填则接口一律 401。
SITE_API_KEY=
