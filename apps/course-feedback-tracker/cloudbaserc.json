{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.0",
  "envId": "jingshi-test-d5gp401i44a0fa7a7",
  "region": "ap-shanghai",
  "functionRoot": "dist-functions",
  "functions": [
    {
      "name": "feedback-api",
      "timeout": 300,
      "memorySize": 512,
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "installDependency": false,
      "description": "月度反馈问卷：飞书课表同步、答卷对账、扫码短链接、飞书事件回调",
      "triggers": [
        {
          "name": "reconcileResponses",
          "type": "timer",
          "config": "0 */5 * * * * *"
        }
      ]
    }
  ],
  "framework": {
    "name": "course-feedback-tracker",
    "plugins": {
      "web": {
        "use": "@cloudbase/framework-plugin-website",
        "inputs": {
          "outputPath": "dist",
          "cloudPath": "/",
          "buildCommand": "npm run build"
        }
      }
    }
  }
}
