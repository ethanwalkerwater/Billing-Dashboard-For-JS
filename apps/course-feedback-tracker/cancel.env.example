# 仅用于 CloudBase 云函数 cancel-api（学生自助取消课程）。复制为 cancel.env，不要提交。
# 独立的飞书应用（机器人「课表分析」）：需要多维表格读写、机器人发消息权限
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 课表：先指向测试课表，验证通过后改成主课表（Xb34bXSVRaQk7ysfAQScPZp5nPh / tblWoTVtU4lqJoes）
CANCEL_SCHEDULE_APP_TOKEN=MNPwb3DPbagmk6snfoDckIXcnVf
CANCEL_SCHEDULE_TABLE_ID=tblLiuzcFFWw6JAU
# 学员信息表（仅生成链接脚本用；主课表为 tblQGkH5DweXpOW8）
CANCEL_STUDENT_TABLE_ID=tblCmyW8aZvK4N3T

# 「取消申请」问卷表（与课表同一个多维表格）和它的表单分享链接
CANCEL_REQUEST_APP_TOKEN=MNPwb3DPbagmk6snfoDckIXcnVf
CANCEL_REQUEST_TABLE_ID=
CANCEL_FORM_URL=

# 教务群（机器人已入群）
