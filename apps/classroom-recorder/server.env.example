# 仅用于云函数 classroom-api。复制为 server.env 填入真实值，不要提交（已在 .gitignore）。
# 飞书应用 = 机器人「课表分析」cli_a93a4faca0f8dcb6（同 teacher-birthday / cancel-api），需开通网页登录、获取用户基本信息、机器人发消息、多维表格读取
FEISHU_APP_ID=cli_a93a4faca0f8dcb6
FEISHU_APP_SECRET=
# 老师档案（飞书账号 → 课表名 / 姓名）
TEACHER_APP_TOKEN=JfncbHflsaXCKTsTyjycnBtYnsf
TEACHER_TABLE_ID=tbl04lXBPk2YkIif
# 课表
SCHEDULE_APP_TOKEN=Xb34bXSVRaQk7ysfAQScPZp5nPh
SCHEDULE_TABLE_ID=tblWoTVtU4lqJoes
# 云函数对外地址（HTTP 访问服务路径 /classroom-api）；飞书回调 = 它 + /auth/callback，须在飞书后台登记
API_BASE_URL=https://app.jsjy.asia/classroom-api
# 报告网页（静态托管 /classroom），报告链接 = 它 + ?t=<token>
REPORT_BASE_URL=https://app.jsjy.asia/classroom/report.html
# 腾讯云录音文件识别（子账号只授 QcloudASRFullAccess 即可）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 识别引擎：大模型 2.0（中英粤 + 方言，0.8 元/小时）；标准版 16k_zh 1.75 元/小时且英语差
ASR_ENGINE=16k_zh_en_2.0
# OpenAI 兼容 chat/completions，生成家长总结 + 完整报告
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
# CloudBase PostgreSQL（PostgREST，service_role 绕过 RLS）。API Key 用 tcb env apikey create 生成，同 course-feedback-tracker
CLOUDBASE_ENV_ID=jingshi-test-d5gp401i44a0fa7a7
CLOUDBASE_API_KEY=
# 后台 /classroom/admin.html 的管理员飞书 open_id（逗号分隔）；不在名单里的人登录后会看到自己的 open_id，发给管理员加进来
ADMIN_OPEN_IDS=
