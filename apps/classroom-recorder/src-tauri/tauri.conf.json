{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "菁仕课堂",
  "version": "0.1.7",
  "identifier": "asia.jsjy.classroom",
  "build": {
    "devUrl": "http://127.0.0.1:4181",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "菁仕课堂",
        "width": 980,
        "height": 620,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        }
      },
      {
        "label": "pill",
        "url": "pill.html",
        "title": "菁仕课堂",
        "width": 420,
        "height": 56,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "fab",
        "url": "fab.html",
        "title": "菁仕课堂",
        "width": 64,
        "height": 64,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "toast",
        "url": "toast.html",
        "title": "菁仕课堂",
        "width": 400,
        "height": 247,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDNTJGRTkzNkVCODA4RDMKUldUVENMaHVrLzVTakZDY01lMU1VbW5wVW5uU3ZLMldOVlNlQkRMNmhyUGF5YzR5TjFYbjVuRnAK",
      "endpoints": [
        "https://app.jsjy.asia/downloads/classroom/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
