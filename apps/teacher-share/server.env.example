# 云函数 share-api 的环境变量。复制为 server.env 填入真实值；server.env 已 gitignore。
CLOUDBASE_ENV_ID=jingshi-test-d5gp401i44a0fa7a7
# CloudBase 环境 API Key（service_role）：读写 teacher_shares、查 feedback_admins 判断是不是教务
CLOUDBASE_API_KEY=
# 和官网之间的密钥：官网 .env.production.local 的 TEACHER_STATS_KEY（= feedback-api 的 SITE_API_KEY），32 位以上
SITE_KEY=
# 官网缓存作废接口；留空默认 https://jsjy.asia/api/revalidate
SITE_REVALIDATE_URL=https://jsjy.asia/api/revalidate
